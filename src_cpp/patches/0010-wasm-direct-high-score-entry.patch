 int high_score::read()
 {
@@ -106,6 +112,18 @@ void high_score::place_new_score_into(high_score_entry data)
 	}
 }
 
+#ifdef __EMSCRIPTEN__
+bool high_score::commit_score_direct(high_score_struct entry)
+{
+	auto position = get_score_position(entry.Score);
+	if (position < 0)
+		return false;
+	place_new_score_into({entry, position});
+	++WasmCommitCount;
+	return true;
+}
+#endif
+
