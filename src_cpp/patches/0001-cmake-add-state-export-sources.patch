     set(CMAKE_OSX_DEPLOYMENT_TARGET "10.11")
-    set(CMAKE_OSX_ARCHITECTURES "arm64;x86_64")
+    # 3DPinball-DrosophilaCadet: allow -DCMAKE_OSX_ARCHITECTURES=<arch> to override the
