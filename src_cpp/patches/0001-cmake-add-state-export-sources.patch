 # SDL2main is not needed
 set(SDL2_BUILDING_LIBRARY ON)
 
-find_package(SDL2 REQUIRED)
-FIND_PACKAGE(SDL2_mixer REQUIRED)
-
-include_directories(${SDL2_INCLUDE_DIR} ${SDL2_MIXER_INCLUDE_DIR})
+# 3DPinball-DrosophilaCadet: Emscripten's ported SDL2/SDL2_mixer aren't real library files this
+# project's custom CMakeModules/FindSDL2.cmake can FIND_LIBRARY - they're supplied purely via
+# -sUSE_SDL=2/-sUSE_SDL_MIXER=2 compile+link flags (set in scripts/build_wasm.sh), so skip the
+# native find_package() path entirely under Emscripten.
+if(NOT EMSCRIPTEN)
+    find_package(SDL2 REQUIRED)
+    FIND_PACKAGE(SDL2_mixer REQUIRED)
+    include_directories(${SDL2_INCLUDE_DIR} ${SDL2_MIXER_INCLUDE_DIR})
+endif()
